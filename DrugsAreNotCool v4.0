            continue

        total_drugs = sum(drugs.values())
        check_objectives()
        check_achievements()

        stats = [
            ("Day", day),
            ("Level", level),
            ("XP", f"{xp}/{xp_needed}"),
            ("Money", f"${money}"),
            ("Risk", f"{risk}%"),
            ("Rep", reputation),
            ("Drugs", f"{sum(drugs.values())}"),
            ("Growing Solution", growing_solution),
        ]

        render_panel("BASE", stats)
        drug_display = " | ".join(f"{d}: {c}" for d, c in drugs.items())
        seed_display = " | ".join(f"{d}: {c}" for d, c in seeds.items())

        if not objective_state:
            objective_state = initialize_objectives()

        objective_count = len(objective_state)
        completed_objectives = sum(1 for objective in objective_state.values() if objective["done"])

        next_unlock = "All drugs unlocked"
