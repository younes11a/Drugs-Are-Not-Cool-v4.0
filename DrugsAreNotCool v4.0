# ============================================================================
# PRINT FUNCTIONS
# ============================================================================

def slow_print(text, delay=0.05):
    """Print text with a typewriter effect."""
    for letter in text:
        sys.stdout.write(letter)
        sys.stdout.flush()
        time.sleep(delay)
    print()

def very_slow_print(text, delay=0.07):
    """Print text with a slower typewriter effect."""
    for letter in text:
        sys.stdout.write(letter)
        sys.stdout.flush()
        time.sleep(delay)
    print()


# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

def clear_screen():
    """Clear the terminal so menus don't keep stacking on screen."""
    if HAS_RICH and console is not None:
        console.clear()
        return

    if os.name == "nt":
        os.system("cls")
    else:
        os.system("clear")

    print("\033[2J\033[H", end="", flush=True)


def input_number(prompt, valid_values):
    """Ask for a numeric input and reject invalid choices."""
    while True:
        value = input(prompt).strip()
        if value.isdigit():
            number = int(value)
            if number in valid_values:
                return number
        if HAS_RICH and console is not None:
            console.print("[bold red]Invalid choice.[/bold red] Please type one of the listed numbers.")
        else:
            print("Invalid choice. Please type one of the listed numbers.")


def render_panel(title, rows):
    """Render a clean terminal panel for the main menu and status screens."""
    if HAS_RICH and console is not None:
        table = Table(show_header=False, box=box.SIMPLE_HEAVY)
        table.add_column("Label", style="bold cyan")
        table.add_column("Value", style="bold white")
        for label, value in rows:
            table.add_row(str(label), str(value))
        console.print(Panel.fit(table, title=title, border_style="cyan"))
    else:
        print(f"\n=== {title} ===")
        for label, value in rows:
            print(f"{label}: {value}")


def render_menu(title, options):
    """Render a clean menu list with numbered choices."""
    if HAS_RICH and console is not None:
        menu = Table(show_header=False, box=box.SIMPLE)
        menu.add_column("Option", style="bold white")
        for option in options:
            menu.add_row(option)
        console.print(Panel.fit(menu, title=title, border_style="green"))
    else:
        print(f"\n=== {title} ===")
        for option in options:
            print(option)


def apply_cheat(code):
    """Handle secret codes for fun gameplay boosts."""
    global money, reputation, workers, risk, drugs, seeds, growing_solution, unlocked_drugs
    global stations, recipes, level, xp, xp_needed, objective_state, total_earned

    key = code.strip().lower()

    cheat_actions = {
        "greenlight": lambda: (
            [unlocked_drugs.append(d) for d in DRUG_CONFIG.keys() if d not in unlocked_drugs],
            [stations.__setitem__("Grow Room", True), stations.__setitem__("Lab", True)],
            [recipes.__setitem__(d, True) for d in recipes.keys()],
            slow_print("Cheat activated: Greenlight. Everything is unlocked."),
            check_objectives()
        ),
        "bigboss": lambda: (
            money.__class__(money + 1000),
            slow_print("Cheat activated: Big Boss. +$1000, +25 rep, +3 workers."),
            setattr(__import__('builtins'), 'money', money) if False else None,
        ),
        "levelup": lambda: add_xp(150),
        "cashme": lambda: (globals().__setitem__('money', money + 500), slow_print("Cheat activated: Cash Me. +$500.")),
        "freebase": lambda: (
            [seeds.__setitem__(d, seeds.get(d, 0) + 20) for d in DRUG_CONFIG.keys()],
            globals().__setitem__('growing_solution', growing_solution + 30),
            slow_print("Cheat activated: Freebase. Supplies refilled.")
        ),
        "clean": lambda: (globals().__setitem__('risk', 0), slow_print("Cheat activated: Clean. Risk reset to 0.")),
        "cheathelp": lambda: slow_print("Cheats: greenlight, bigboss, cashme, freebase, levelup, clean")
    }

    if key == "bigboss":
        globals()['money'] = money + 1000
        globals()['reputation'] = reputation + 25
        globals()['workers'] = workers + 3
        slow_print("Cheat activated: Big Boss. +$1000, +25 rep, +3 workers.")
        check_objectives()
        return True

    if key == "greenlight":
        for drug_name in DRUG_CONFIG:
            if drug_name not in unlocked_drugs:
                unlocked_drugs.append(drug_name)
        stations["Grow Room"] = True
        stations["Lab"] = True
        for drug_name in recipes:
            recipes[drug_name] = True
        slow_print("Cheat activated: Greenlight. Everything is unlocked.")
        check_objectives()
        return True

    if key == "cashme":
        globals()['money'] = money + 500
        slow_print("Cheat activated: Cash Me. +$500.")
        check_objectives()
        return True

    if key == "freebase":
        for drug_name in DRUG_CONFIG:
            seeds[drug_name] = seeds.get(drug_name, 0) + 20
        globals()['growing_solution'] = growing_solution + 30
        slow_print("Cheat activated: Freebase. Supplies refilled.")
        return True

    if key == "levelup":
        add_xp(150)
        return True

    if key == "clean":
        globals()['risk'] = 0
        slow_print("Cheat activated: Clean. Risk reset to 0.")
        return True

    if key == "cheathelp":
        slow_print("Cheats: greenlight, bigboss, cashme, freebase, levelup, clean")
        return True

    return False


REAL_INPUT = builtins.input


def cheat_input(prompt=""):
    """Intercept cheat commands entered from the terminal."""
    try:
        value = REAL_INPUT(prompt)
    except (EOFError, KeyboardInterrupt):
        return ""

    if isinstance(value, str) and apply_cheat(value):
        return cheat_input(prompt)
    return value


builtins.input = cheat_input


def generate_hash(data):
    """Generate SHA256 hash for save file integrity."""
    return hashlib.sha256(data.encode()).hexdigest()


def get_seed_price(drug_name):
    """Return a random seed price from the configured range for a drug."""
    config = DRUG_CONFIG[drug_name]
    return random.randint(*config["seed_price"])


def get_sale_price(drug_name, order_amount=1, multiplier=1.0):
    """Return a sell price based on the configured market, order size, and difficulty."""
    config = DRUG_CONFIG[drug_name]
    base_price = random.randint(*config["sell_price"])
    bulk_bonus = 1 + (max(order_amount - 1, 0) * 0.1)

    # Slightly better sales as the player builds reputation.
    reputation_bonus = 1 + (reputation * 0.02)

    # Make drug tiers feel distinct: weed is stable, meth is a stronger mid-game, cocaine is premium.
    drug_bonus = {
        "Weed": 1.0,
        "Meth": 1.15,
        "Cocaine": 1.3,
    }.get(drug_name, 1.0)

    difficulty_bonus = DIFFICULTY_SETTINGS.get(difficulty, DIFFICULTY_SETTINGS["normal"])["price_multiplier"]

    return int(base_price * bulk_bonus * multiplier * reputation_bonus * drug_bonus * difficulty_bonus)


def add_activity(message):
    """Record a short recent event for the player's status feed."""
    activity_log.append(message)
    if len(activity_log) > 5:
        activity_log.pop(0)


def get_activity_feed():
    """Return the latest activity messages for the base HUD."""
    if not activity_log:
        return "No recent activity."
    return " | ".join(activity_log[-3:])


def get_base_hint():
    """Return a short, state-aware hint for the player."""
    if risk >= 70:
        return "Tip: risk is high — consider sleeping or using a bribe."
    if money < 80:
        return "Tip: cash is low — sell in the city or buy cheaper seeds."
    if not any(drugs.get(drug, 0) > 0 for drug in unlocked_drugs):
        return "Tip: start by producing Weed and getting your first sale."
    if not objective_state:
        return "Tip: keep an eye on the objectives tab for your next milestone."

    for objective in objective_state.values():
        if not objective["done"]:
            return f"Tip: next milestone: {objective['title']}"

    return "Tip: save your game, then push your operation further."


