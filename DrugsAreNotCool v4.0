def main_menu():
    """Display the polished main menu with numbered choices."""
    while True:
        clear_screen()
        options = [
            "1. Start Game",
            "2. Load Game",
            "3. How to Play",
            "4. Credits",
            "5. Exit",
        ]
        render_panel("DRUGS ARE NOT COOL", [("Status", "Operation Online")])
        render_menu("MAIN MENU", options)

        choice = input_number("Choose: ", [1, 2, 3, 4, 5, 911])

        if choice == 1:
            difficulty_menu()
        elif choice == 2:
            load_game_menu()
        elif choice == 3:
            how_to_play()
        elif choice == 4:
            credits()
        elif choice == 5:
            quit_game()
        elif choice == 911:
            start_game()  # Secret code to start game immediately


def load_game_menu():
    """Display load game menu with list of saves."""
    clear_screen()
    saves = list_saves()

    if not saves:
        slow_print("No save files found.")
        return

    print("\n====== LOAD GAME ======")
    for i, save_name in enumerate(saves, 1):
        print(f"{i}. {save_name}")
    print("D. Delete Save")
    print("0. Back")

    choice = input("Choose: ")

    if choice == "0":
        return
    
    if choice.lower() == "d":
        delete_save_menu(saves)
        return

    try:
        idx = int(choice) - 1
        if 0 <= idx < len(saves):
            if load_game(saves[idx]):
                generate_customers()
                base_menu()
            else:
                slow_print("Failed to load save.")
        else:
            slow_print("Invalid choice.")
    except ValueError:
        slow_print("Please enter a valid number.")


def delete_save_menu(saves):
    """Delete a save file."""
    clear_screen()
    print("\n====== DELETE SAVE ======")
    for i, save_name in enumerate(saves, 1):
        print(f"{i}. {save_name}")
    print("0. Back")
    
    choice = input("Enter number to delete: ")
    
    if choice == "0":
        return
    
    try:
        idx = int(choice) - 1
        if 0 <= idx < len(saves):
            save_name = saves[idx]
            confirm = input(f"Delete '{save_name}'? (y/n): ")
            if confirm.lower() == "y":
                filename = get_save_filename(save_name)
                filepath = os.path.join("saves", filename)
                if os.path.exists(filepath):
                    os.remove(filepath)
                    slow_print(f"Save '{save_name}' deleted!")
                else:
                    slow_print("Save file not found.")
            else:
                slow_print("Cancelled.")
        else:
            slow_print("Invalid choice.")
    except ValueError:
        slow_print("Please enter a valid number.")


