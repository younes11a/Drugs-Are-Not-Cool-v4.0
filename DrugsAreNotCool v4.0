# WORKER SYSTEM
# ============================================================================

def city_hire_worker():
    """Hire a worker from the city."""
    global money, workers

    cost = 200

    print("\n====== HIRE WORKER ======")
    slow_print(f"Current Workers: {workers}")
    slow_print(f"Hiring Cost: ${cost}")
    print("1. Hire")
    print("2. Cancel")

    choice = input("Choose: ")

    if choice == "1":
        if money >= cost:
            money -= cost
            workers += 1
            slow_print("You hired a worker from the city.")
        else:
            slow_print("Not enough money.")


def worker_production():
    """Workers produce random unlocked drugs each day."""
    global drugs, workers, seeds, growing_solution, unlocked_drugs

    if workers <= 0:
        return

    production_log = {}

    # Use a list-based loop to avoid range-related tooling issues in some editors.
    for _ in [None] * max(0, workers):
        # Pick a random unlocked drug that can be produced
        valid_drugs = []
        for drug_type in unlocked_drugs:
            config = DRUG_CONFIG[drug_type]
            station_needed = config.get("station", "Grow Room")
            
            # Check station ownership
            if not stations.get(station_needed, False):
                continue
            # Check recipe ownership
            if config.get("has_recipe", False) and not recipes.get(drug_type, False):
                continue
            # Check if we have materials
            if seeds.get(drug_type, 0) <= 0 or growing_solution <= 0:
                continue
            
            valid_drugs.append(drug_type)
        
        if not valid_drugs:
            break
        
        drug_type = random.choice(valid_drugs)
        
        # Consume materials
        seeds[drug_type] -= 1
        growing_solution -= 1

        # Add 1 of that drug (doubled if Chemist)
        produced = 2 if upgrades["Chemist"] else 1
        drugs[drug_type] += produced

        # Track production for display
        if drug_type in production_log:
            production_log[drug_type] += produced
        else:
            production_log[drug_type] = produced

    # Print what was produced
    if production_log:
        result = ", ".join(f"{k}: {v}" for k, v in production_log.items())
        slow_print(f"Workers produced -> {result}")
    else:
        slow_print("Workers couldn't produce any drugs (missing materials or stations).")


# ============================================================================
# SLEEP SYSTEM
# ============================================================================

def sleep():
    """Advance to the next day."""
    global day, risk, in_jail, jail_days, supplier_visited_today
    global jail_rep_used, jail_train_used, jail_lawyer_used

    slow_print("You go to sleep...")
    day += 1
    supplier_visited_today = False

    # Reset jail daily actions
    jail_rep_used = False
    jail_train_used = False
    jail_lawyer_used = False

    if in_jail:
        jail_days -= 1
        slow_print(f"You are in jail. {jail_days} days remaining.")

        if jail_days <= 0:
            in_jail = False
            slow_print("You were released from jail.")
    else:
        risk = max(0, risk - 20)
        worker_production()
        check_for_arrest()

    generate_customers()
    save_game()
    slow_print("A new day begins.")


# ============================================================================
# DRUG STATION
# ============================================================================

def drug_station():
    """Produce drugs from seeds and growing solution."""
    global drugs, seeds, growing_solution, max_production

    print("\n====== DRUG STATION ======")
    # Show seeds per drug type
    print("Seeds:")
    for drug_name, count in seeds.items():
        print(f"  {drug_name}: {count}")
    slow_print(f"Growing Solution: {growing_solution}")
    slow_print(f"Max Production Per Visit: {max_production}")
    print("1. Make Drugs")
    print("2. Return")
    print("0. Quit Game")

    choice = input("Choose: ")

    if choice == "1":
        # Show available drug types based on unlocked drugs AND station ownership
        print("\nAvailable drug types:")
        available_drugs = []
        for i, d in enumerate(unlocked_drugs):
            config = DRUG_CONFIG[d]
            station_needed = config.get("station", "Grow Room")
            has_recipe = config.get("has_recipe", False)
            
            # Check station ownership
            if not stations.get(station_needed, False):
                continue
            # Check recipe ownership
            if has_recipe and not recipes.get(d, False):
                continue
            
            available_drugs.append(d)
            print(f"{len(available_drugs)}. {d}")
        
        if not available_drugs:
            slow_print("You don't have the required station or recipe!")
            return
        
        try:
            choice = int(input("Choose drug type: "))
            if choice < 1 or choice > len(available_drugs):
                slow_print("Invalid choice.")
                return
            drugtype = available_drugs[choice - 1]
        except ValueError:
            slow_print("Please enter a valid number.")
            return
        
        try:
            amount = int(input("How many drugs do you want to make? "))
        except ValueError:
            slow_print("Please enter a valid number")
            return

        if amount > max_production:
            slow_print(f"You can only produce up to {max_production} at once.")
            return

        # Check seeds for the specific drug type
        if seeds.get(drugtype, 0) >= amount and growing_solution >= amount:
            # Deduct materials
            seeds[drugtype] -= amount
            growing_solution -= amount

            produced = amount * (2 if upgrades["Chemist"] else 1)
            drugs[drugtype] += produced
            slow_print(f"You produced {produced} {drugtype}.")
        else:
            slow_print("Not enough materials.")

    elif choice == "0":
        quit_game()


