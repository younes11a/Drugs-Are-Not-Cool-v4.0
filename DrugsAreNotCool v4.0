def difficulty_menu():
    """Choose a difficulty before starting the game."""
    global difficulty

    while True:
        clear_screen()
        render_panel("DIFFICULTY", [("Mode", DIFFICULTY_SETTINGS.get(difficulty, DIFFICULTY_SETTINGS["normal"])["label"])])
        render_menu("SELECT DIFFICULTY", [
            "1. Easy",
            "2. Normal",
            "3. Hard",
            "4. Back",
        ])

        choice = input_number("Choose: ", [1, 2, 3, 4])

        if choice == 1:
            difficulty = "easy"
            start_game()
            return
        elif choice == 2:
            difficulty = "normal"
            start_game()
            return
        elif choice == 3:
            difficulty = "hard"
            start_game()
            return
        elif choice == 4:
            return


def start_game():
    """Initialize a new game."""
    global org_name, day, money, drugs, seeds, growing_solution
    global risk, reputation, deliveries_done, max_production, workers
    global level, xp, xp_needed
    global in_jail, jail_days, unlocked_drugs, stations, recipes, total_earned, objective_state, achievements
    global difficulty, activity_log, supplier_visited_today

    # Reset all game state
    day = 1
    money = DIFFICULTY_SETTINGS.get(difficulty, DIFFICULTY_SETTINGS["normal"])["start_money"]
    drugs = {
        "Weed": 0,
        "Cocaine": 0,
        "Meth": 0
    }
    seeds = {
        "Weed": 0,
        "Meth": 0,
        "Cocaine": 0
    }
    growing_solution = 0
    risk = 0
    reputation = 0
    deliveries_done = 0
    max_production = 5
    workers = 0
    level = 1
    xp = 0
    xp_needed = 100
    in_jail = False
    jail_days = 0
    total_earned = 0
    objective_state = initialize_objectives()
    achievements = initialize_achievements()
    activity_log = []
    supplier_visited_today = False
    unlocked_drugs = ["Weed"]  # Start with only Weed unlocked
    stations = {
        "Grow Room": True,  # Start with Grow Room unlocked for Weed
        "Lab": False
    }
    recipes = {
        "Weed": False,
        "Meth": False,
        "Cocaine": False
    }
    upgrades["Safe House"] = False
    upgrades["Police Bribe"] = False
    upgrades["Chemist"] = False

    generate_customers()

    slow_print("\nStarting the game...")
    org_name = input("Enter your organization name: ")

    slow_print("You are a low life criminal starting a new drug business.")
    slow_print("You find yourself in a city with no money, health problems, and illegal immigrants.")
    slow_print("After 3 rough days with no food you meet Uncle Bob who is a former drug dealer.")
    add_activity("New operation launched")
    slow_print("Uncle bob leads you to his old garage and told you to use it as a base.")
    slow_print("You reach Uncle Bob's garage which to your suprise is pretty clean.")
    slow_print("\n*** TIP: Level up to unlock more drugs! Weed is available now. ***")
    slow_print(f"   - Meth unlocks at Level 3")
    slow_print(f"   - Cocaine unlocks at Level 5")

    # Auto-save new game
    save_game(org_name)

    base_menu()


