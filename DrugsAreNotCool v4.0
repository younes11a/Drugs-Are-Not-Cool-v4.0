# BLACK MARKET
# ============================================================================

def black_market():
    """Black market menu with polished number-based layout."""
    global drugs, money, risk, reputation

    while True:
        clear_screen()
        render_panel("BLACK MARKET", [("Money", f"${money}"), ("Risk", f"{risk}%"), ("Rep", reputation)])
        render_menu("BLACK MARKET", [
            "1. Sell Drugs",
            "2. Buy Stations & Recipes",
            "3. Leave",
        ])

        choice = input_number("Choose: ", [1, 2, 3])

        if choice == 1:
            sell_drugs_black_market()
        elif choice == 2:
            buy_stations_recipes()
        elif choice == 3:
            return


def sell_drugs_black_market():
    """Sell drugs at high risk high reward black market."""
    global drugs, money, risk, reputation, total_earned

    if reputation < 20:
        slow_print("You are not known enough.")
        return

    # Check if player has any drugs
    available_drugs = [d for d in unlocked_drugs if drugs.get(d, 0) > 0]
    if not available_drugs:
        slow_print("You have no drugs.")
        return

    # Customer randomly requests multiple drugs based on level (capped at 10)
    max_order = min(level, 10)
    order_amount = random.randint(1, max_order)
    
    requested_drug = random.choice(available_drugs)
    sell_price = get_sale_price(requested_drug, order_amount, multiplier=1.5)

    print(f"\n[$] Black market buyer wants {order_amount} {requested_drug}")
    print(f"They'll pay ${sell_price} each (${sell_price * order_amount} total)")

    print("\n1. Sell")
    print("2. Cancel")

    choice = input("Choose: ")

    if choice == "1":
        if drugs[requested_drug] >= order_amount:
            drugs[requested_drug] -= order_amount
            revenue = sell_price * order_amount
            total_earned += revenue
            money += revenue
            add_xp(40 * order_amount)
            risk += 30
            check_for_arrest()
            check_objectives()
            slow_print(f"Black Market Sale: {order_amount} {requested_drug} sold for ${revenue}")
        else:
            slow_print(f"You don't have enough {requested_drug}! (Need {order_amount}, have {drugs[requested_drug]})")
    else:
        slow_print("You declined the deal.")


def buy_stations_recipes():
    """Buy stations and recipes from the black market with a cleaner menu."""
    global money, stations, recipes

    while True:
        clear_screen()
        station_prices = {"Grow Room": 500, "Lab": 800}
        recipe_prices = {"Cocaine": 300}

        render_panel("BLACK MARKET - STOCK", [("Money", f"${money}"), ("Rep", reputation)])

        station_options = []
        recipe_options = []
        menu_rows = []

        for station_name, price in station_prices.items():
            owned = stations.get(station_name, False)
            if owned:
                menu_rows.append(f"{len(menu_rows) + 1}. {station_name}: OWNED")
            elif station_name == "Lab" and level < 3:
                menu_rows.append(f"{len(menu_rows) + 1}. {station_name}: LOCKED (Level 3)")
            else:
                menu_rows.append(f"{len(menu_rows) + 1}. {station_name}: ${price}")
                station_options.append((station_name, price))

        for drug_name, price in recipe_prices.items():
            owned = recipes.get(drug_name, False)
            if owned:
                menu_rows.append(f"{len(menu_rows) + 1}. {drug_name} Recipe: OWNED")
            elif drug_name == "Cocaine" and level < 5:
                menu_rows.append(f"{len(menu_rows) + 1}. {drug_name} Recipe: LOCKED (Level 5)")
            elif stations.get(DRUG_CONFIG[drug_name].get("station", "Grow Room"), False):
                menu_rows.append(f"{len(menu_rows) + 1}. {drug_name} Recipe: ${price}")
                recipe_options.append((drug_name, price))

        menu_rows.append(f"{len(menu_rows) + 1}. Leave")
        render_menu("STATIONS & RECIPES", menu_rows)

        choice = input_number("Choose: ", list(range(1, len(menu_rows) + 1)))
        if choice == len(menu_rows):
            return

        if choice <= len(station_options):
            station_name, price = station_options[choice - 1]
            if money >= price:
                money -= price
                stations[station_name] = True
                slow_print(f"You bought the {station_name}!")
            else:
                slow_print("Not enough money.")
        else:
            recipe_index = choice - len(station_options) - 1
            if 0 <= recipe_index < len(recipe_options):
                drug_name, price = recipe_options[recipe_index]
                if money >= price:
                    money -= price
                    recipes[drug_name] = True
                    slow_print(f"You bought the {drug_name} recipe!")
                else:
                    slow_print("Not enough money.")
            else:
                slow_print("Invalid choice.")

        return


# ============================================================================
# UPGRADES
# ============================================================================

def upgrade_menu():
    """Purchase base upgrades with a cleaner terminal layout."""
    global money, max_production

    while True:
        clear_screen()
        available = []
        if not upgrades["Safe House"]:
            available.append("1. Safe House ($200)")
        if not upgrades["Police Bribe"]:
            available.append("2. Police Bribe ($150)")
        if not upgrades["Chemist"]:
            available.append("3. Hire Chemist ($300)")
        if max_production < 20:
            available.append("4. Production Upgrade ($250)")

        purchased_count = sum([
            upgrades["Safe House"],
            upgrades["Police Bribe"],
            upgrades["Chemist"],
            max_production >= 20,
        ])

        if purchased_count == 4:
            slow_print("All upgrades already purchased!")
            return

        available.append(f"{len(available) + 1}. Exit")
        render_panel("UPGRADES", [("Money", f"${money}"), ("Production", max_production)])
        render_menu("UPGRADE SHOP", available)

        choice = input_number("Choose: ", list(range(1, len(available) + 1)))

        if choice == 1 and not upgrades["Safe House"] and money >= 200:
            money -= 200
            upgrades["Safe House"] = True
            slow_print("Safe House purchased! Risk from street deals reduced by 20%.")
        elif choice == 2 and not upgrades["Police Bribe"] and money >= 150:
            money -= 150
            upgrades["Police Bribe"] = True
            slow_print("Police Bribe purchased! Risk from street deals reduced by 30%.")
        elif choice == 3 and not upgrades["Chemist"] and money >= 300:
            money -= 300
            upgrades["Chemist"] = True
            slow_print("Chemist hired! Drug production doubled.")
        elif choice == 4 and max_production < 20 and money >= 250:
            money -= 250
            max_production += 5
            slow_print("Production capacity increased by 5!")
        elif choice == len(available):
            return
        else:
            slow_print("Invalid choice or not enough money.")


