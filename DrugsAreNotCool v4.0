# ============================================================================
# STORE (DRUGZON)
# ============================================================================

def store():
    """Online store to buy seeds and growing solution with a cleaner interface."""
    global money, seeds, growing_solution

    while True:
        clear_screen()
        render_panel("DRUGZON", [("Money", f"${money}"), ("Growing Solution", growing_solution)])

        store_seed_options = []
        options = []
        for drug_name in DRUG_CONFIG.keys():
            config = DRUG_CONFIG[drug_name]
            if level >= config["unlock_level"]:
                station_needed = config.get("station", "Grow Room")
                if not stations.get(station_needed, False):
                    continue
                if config.get("has_recipe", False) and not recipes.get(drug_name, False):
                    continue
                seed_price = get_seed_price(drug_name)
                store_seed_options.append((drug_name, config["seed_name"], seed_price))
                options.append(f"{len(options) + 1}. {config['seed_name']} (${seed_price} each)")

        options.append(f"{len(options) + 1}. Buy Growing Solution ($15 each)")
        options.append(f"3. Exit")
        options.append("0. Quit Game")

        render_menu("AVAILABLE SEEDS", options)
        valid = list(range(0, len(options) + 1))
        valid = [v for v in valid if v != len(options)]
        choice = input_number("Choose: ", list(range(0, len(options))))

        if choice == 0:
            quit_game()
        elif choice == len(options) - 1:
            return
        elif choice == len(options) - 2:
            try:
                amount = int(input("How many growing solutions do you want to buy? "))
                total_cost = amount * 15
            except ValueError:
                slow_print("Please enter a valid number.")
                continue

            if money >= total_cost:
                money -= total_cost
                growing_solution += amount
                slow_print(f"You bought {amount} growing solutions.")
            else:
                slow_print("Not enough money.")
        elif 1 <= choice <= len(store_seed_options):
            drug_name, seed_name, seed_price = store_seed_options[choice - 1]
            try:
                amount = int(input(f"How many {seed_name} do you want to buy? "))
                total_cost = amount * seed_price
            except ValueError:
                slow_print("Please enter a valid number")
                continue

            if money >= total_cost:
                money -= total_cost
                seeds[drug_name] = seeds.get(drug_name, 0) + amount
                slow_print(f"You bought {amount} {seed_name} for ${total_cost}.")
            else:
                slow_print("Not enough money.")
        else:
            slow_print("Invalid Input")



# ============================================================================
# NEGOTIATION SYSTEM
# (Paste this block ABOVE the "# EMAIL SYSTEM" section of your game file.)
# ============================================================================

# Each buyer has a personality: how many times they'll put up with haggling
# (patience) and how far above their first offer they'd secretly be willing to go.
NEGOTIATION_PERSONALITIES = {
    "Stingy":    {"patience": 2, "ceiling": (1.05, 1.15), "mood": "grumbles"},
    "Fair":      {"patience": 3, "ceiling": (1.10, 1.30), "mood": "shrugs"},
    "Desperate": {"patience": 4, "ceiling": (1.25, 1.60), "mood": "sweats"},
}


def negotiate_price(customer, drug_name, amount, offer):
    """Haggle with a buyer.

    Returns the agreed price PER UNIT, or None if the buyer walks away
    (or you walk away). Reputation and level improve your odds.
    """
    # Skill bonuses: up to +20% from reputation, up to +10% from level
    skill = min(reputation, 50) * 0.004 + min(level, 10) * 0.01

    personality_name = random.choice(list(NEGOTIATION_PERSONALITIES.keys()))
    personality = NEGOTIATION_PERSONALITIES[personality_name]
    patience = personality["patience"]

    # Hidden maximum the buyer would ever pay per unit
    ceiling = int(offer * random.uniform(*personality["ceiling"]))
    ceiling = max(ceiling, offer)

    current = offer
    rounds = 0

    slow_print(f"\n--- NEGOTIATION with {customer} ---")
    slow_print(f"They want {amount} {drug_name}. They seem {personality_name.lower()}.")

    while True:
        print(f"\nCurrent offer: ${current} each (${current * amount} total)")
        print(f"Their patience: {'*' * patience}{'.' * (personality['patience'] - patience)}")
        print("1. Accept this price")
        print("2. Ask for a bit more (+10%)")
        print("3. Push hard (+25%)")
        print("4. Bluff: 'I have other buyers' (risky, big payoff)")
        print("5. Walk away")

        choice = input_number("Choose: ", [1, 2, 3, 4, 5])

        if choice == 1:
            if current > offer:
                gain = (current - offer) * amount
                slow_print(f"Deal! You squeezed an extra ${gain} out of {customer}.")
                add_xp(10 * rounds)
            else:
                slow_print("Deal. No haggling, no hassle.")
            return current

        if choice == 5:
            slow_print("You walk away from the deal.")
            return None

        rounds += 1

        if choice == 2:
            target = int(current * 1.10)
            base_chance = 0.75
            patience_cost = 1
        elif choice == 3:
            target = int(current * 1.25)
            base_chance = 0.55
            patience_cost = 1
        else:
            # Bluff: aim for their absolute ceiling
            target = ceiling
            base_chance = 0.35
            patience_cost = 2

        # Make sure a "raise" is always at least $1 more
        target = max(target, current + 1)

        if target <= ceiling:
            chance = base_chance + skill
        else:
            # Asking beyond what they'd ever pay almost never works
            chance = 0.05 + skill * 0.25
        chance = min(max(chance, 0.05), 0.95)

        if random.random() < chance:
            current = min(target, ceiling) if choice == 4 else target
            slow_print(f"{customer} {personality['mood']} and agrees to ${current} each.")
            if current >= ceiling:
                slow_print(f"{customer}: 'That's my limit. Take it or leave it.'")
        else:
            patience -= patience_cost
            if choice == 4:
                slow_print(f"{customer} sees through your bluff and gets angry!")
            else:
                slow_print(f"{customer} refuses to pay more.")

            if patience <= 0:
                slow_print(f"{customer} loses patience and storms off. Deal's off!")
                return None


# ============================================================================
# EMAIL SYSTEM
# ============================================================================

def emails():
    """Process customer emails and make sales."""
    global deliveries_done, drugs, money, reputation, total_earned

    while True:
        customer = get_next_customer()

        if customer is None:
            slow_print("No more customers today.")
            return

        # Customer randomly requests multiple drugs based on level (capped at 10)
        max_order = min(level, 10)
        order_amount = random.randint(1, max_order)
        
        available_drugs = [d for d in unlocked_drugs if drugs.get(d, 0) > 0]
        if not available_drugs:
            slow_print("You have no drugs to sell!")
            return
        
        requested_drug = random.choice(available_drugs)
        sell_price = get_sale_price(requested_drug, order_amount)

        slow_print("\n====New Email====")
        slow_print(f"From: {customer}")
        slow_print(f"Subject: Need {requested_drug}")
        slow_print(f"Message: I need {order_amount} {requested_drug}. Will pay ${sell_price} each.")

        print("1. Send")
        print("2. Next Email")
        print("3. Negotiate Price")
        print("4. Exit")

        choice = input("Choose: ")

        if choice == "1":
            if drugs[requested_drug] >= order_amount:
                drugs[requested_drug] -= order_amount
                revenue = sell_price * order_amount
                total_earned += revenue
                money += revenue
                add_xp(20 * order_amount)
                deliveries_done += 1
                reputation += 2 * order_amount
                check_objectives()
                slow_print(f"Sold {order_amount} {requested_drug} for ${revenue}")
            else:
                slow_print(f"You don't have enough {requested_drug}! (Need {order_amount}, have {drugs[requested_drug]})")
        elif choice == "2":
            continue  # Skip to next customer
        elif choice == "3":
            # Implement price negotiation logic here
            negotiate_price(customer, requested_drug, order_amount, sell_price)
        elif choice == "4":
            return
        else:
            slow_print("Invalid choice.")


# ============================================================================
# CITY
# ============================================================================

def city():
    """City hub with various locations and a polished menu layout."""
    while True:
        clear_screen()
        if in_jail:
            return

        render_panel("CITY", [("Money", f"${money}"), ("Risk", f"{risk}%"), ("Rep", reputation)])
        render_menu("CITY OPTIONS", [
            "1. Street Deal",
            "2. Visit Supplier",
            "3. Black Market",
            "4. Upgrade Base",
            "5. Hire Worker",
            "6. Return",
            "0. Quit Game",
        ])

        choice = input_number("Choose: ", [0, 1, 2, 3, 4, 5, 6])

        if choice == 1:
            street_deal()
        elif choice == 2:
            supplier()
        elif choice == 3:
            black_market()
        elif choice == 4:
            upgrade_menu()
        elif choice == 5:
            city_hire_worker()
        elif choice == 6:
            return
        elif choice == 0:
            quit_game()


# ============================================================================
# STREET DEAL
# ============================================================================

def police_event():
    """Handle police encounter during street deal."""
    global drugs, money, risk

    slow_print("Police spotted you!")

    if random.randint(1, 100) < 50:
        lost = min(sum(drugs.values()), 2)
        # Remove from random drug types
        for _ in range(lost):
            available = [d for d, c in drugs.items() if c > 0]
            if available:
                drug_to_remove = random.choice(available)
                drugs[drug_to_remove] -= 1
        slow_print(f"You dropped {lost} drugs escaping!")
    else:
        fine = min(money, 50)
        money -= fine
        slow_print(f"You paid ${fine} fine.")

    risk += 15
    check_for_arrest()


def street_deal():
    """Sell drugs on the street in different territories."""
    global drugs, money, risk, reputation, total_earned

    # Check if player has any drugs
    available_drugs = [d for d in unlocked_drugs if drugs.get(d, 0) > 0]
    if not available_drugs:
        slow_print("You have no drugs.")
        return

    # Customer randomly requests multiple drugs based on level (capped at 10)
    max_order = min(level, 10)
    order_amount = random.randint(1, max_order)
    
    requested_drug = random.choice(available_drugs)
    sell_price = get_sale_price(requested_drug, order_amount)

    print(f"\n[?] A customer approaches wanting {order_amount} {requested_drug}")
    print(f"They'll pay ${sell_price} each (${sell_price * order_amount} total)")

    print("\nChoose Territory:")
    areas = list(TERRITORIES.keys())
    for i, area in enumerate(areas):
        print(f"{i+1}. {area}")

    # Safe input protection
    try:
        territory_choice = int(input("Choose territory: ")) - 1
        if territory_choice < 0 or territory_choice >= len(areas):
            slow_print("Invalid territory.")
            return
    except ValueError:
        slow_print("Please enter a valid number.")
        return

    area = areas[territory_choice]
    data = TERRITORIES[area]
    chance = random.randint(1, 100)

    if chance < 60:
        # Successful sale
        if drugs[requested_drug] >= order_amount:
            drugs[requested_drug] -= order_amount
            revenue = sell_price * order_amount
            total_earned += revenue
            money += revenue
            add_xp(25 * order_amount)
            reputation += 3 * order_amount
            check_objectives()

            risk_gain = data["risk"]
            if upgrades["Police Bribe"]:
                risk_gain = int(risk_gain * 0.7)

            risk += risk_gain
            check_for_arrest()

            slow_print(f"Sold {order_amount} {requested_drug} for ${revenue}")
        else:
            slow_print(f"You don't have enough {requested_drug}! (Need {order_amount}, have {drugs[requested_drug]})")

    elif chance < 85:
        # No customers
        slow_print("No customers found.")
        risk += 5
        check_for_arrest()

    else:
        # Police encounter
        police_event()


# ============================================================================
# SUPPLIER
# ============================================================================

def supplier():
    """Buy seeds and growing solution from supplier with a polished menu layout."""
    global money, seeds, growing_solution, risk, reputation, level, supplier_visited_today

    if supplier_visited_today:
        slow_print("You already visited the supplier today. Come back tomorrow.")
        return

    while True:
        clear_screen()
        render_panel("SUPPLIER", [("Money", f"${money}"), ("Risk", f"{risk}%")])

        seed_options = []
        options = []
        for drug_name in DRUG_CONFIG.keys():
            config = DRUG_CONFIG[drug_name]
            if level >= config["unlock_level"]:
                station_needed = config.get("station", "Grow Room")
                if not stations.get(station_needed, False):
                    continue
                if config.get("has_recipe", False) and not recipes.get(drug_name, False):
                    continue
                price = get_seed_price(drug_name)
                seed_options.append((drug_name, config["seed_name"], price))
                options.append(f"{len(options) + 1}. {config['seed_name']} (${price} each)")

        if not seed_options:
            slow_print("No seeds available yet. You need to buy a station first!")
            return

        options.append(f"{len(options) + 1}. Leave")
        render_menu("AVAILABLE SEEDS", options)

        choice = input_number("Choose: ", list(range(1, len(options) + 1)))

        if choice == len(options):
            return

        drug_name, seed_name, seed_price = seed_options[choice - 1]

        if random.randint(1, 100) < 20:
            seed_price = int(seed_price * 0.7)
            slow_print("Supplier gives you a discount!")

        try:
            amount = int(input(f"How many {seed_name}? "))
        except ValueError:
            slow_print("Invalid number.")
            continue

        total = seed_price * amount

        if money < total:
            slow_print("Not enough money.")
            continue

        if random.randint(1, 100) < 10:
            lost = int(total * 0.5)
            money -= lost
            slow_print(f"[!] You got scammed! Lost ${lost}")
            supplier_visited_today = True
            return

        money -= total
        seeds[drug_name] = seeds.get(drug_name, 0) + amount
        supplier_visited_today = True
        slow_print(f"You bought {amount} {seed_name}.")

        risk_increase = random.randint(2, 6)
        risk += risk_increase
        slow_print(f"[!] Risk increased by {risk_increase}%")

        check_for_arrest()
        break


