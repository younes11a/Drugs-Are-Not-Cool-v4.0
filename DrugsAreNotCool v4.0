def show_objectives():
    """Display the active progression objectives."""
    print("\n=== OBJECTIVES ===")
    for key, objective in objective_state.items():
        current = objective["progress"]
        goal = objective["goal"]
        status = "DONE" if objective["done"] else f"{current}/{goal}"
        print(f"- {objective['title']}: {status}")


def check_achievements():
    """Update and unlock story achievements based on current progress."""
    global achievements

    if not achievements:
        achievements = initialize_achievements()

    achievements["first_sale"]["done"] = total_earned > 0
    achievements["level_two"]["done"] = level >= 2
    achievements["street_legend"]["done"] = reputation >= 20
    achievements["money_maker"]["done"] = money >= 1000
    achievements["unlock_meth"]["done"] = "Meth" in unlocked_drugs


def achievements_menu():
    """Display the player's achievement progress."""
    global achievements

    while True:
        clear_screen()
        render_panel("ACHIEVEMENTS", [("Difficulty", DIFFICULTY_SETTINGS.get(difficulty, DIFFICULTY_SETTINGS["normal"])["label"])])
        if not achievements:
            achievements = initialize_achievements()
        for key, achievement in achievements.items():
            status = "DONE" if achievement["done"] else "LOCKED"
            print(f"- {achievement['title']}: {status}")
            if not achievement["done"]:
                print(f"  {achievement['description']}")
        print("\nPress Enter to return.")
        input()
        return


def objectives_menu():
    """Dedicated objectives menu with Enter to exit."""
    global objective_state

    while True:
        clear_screen()
        print("\n====== OBJECTIVES ======")
        if not objective_state:
            objective_state = initialize_objectives()
        for objective in objective_state.values():
            current = objective["progress"]
            goal = objective["goal"]
            status = "DONE" if objective["done"] else f"{current}/{goal}"
            print(f"- {objective['title']}: {status}")
        print("\nPress Enter to return.")
        input()
        return


def check_objectives():
    """Update and complete progression objectives."""
    global money, total_earned, objective_state, objective_lock

    if objective_lock:
        return

    if not objective_state:
        objective_state = initialize_objectives()

    objective_lock = True
    try:
        objective_state["cash_250"]["progress"] = total_earned
        objective_state["rep_10"]["progress"] = reputation
        objective_state["unlock_meth"]["progress"] = 1 if "Meth" in unlocked_drugs else 0
        objective_state["weed_20"]["progress"] = drugs.get("Weed", 0)

        for key, objective in objective_state.items():
            if objective["done"]:
                continue

            if objective["progress"] >= objective["goal"]:
                objective["done"] = True
                money += objective["reward_money"]
                add_xp(objective["reward_xp"])
                slow_print(f"\nOBJECTIVE COMPLETE: {objective['title']}")
                slow_print(f"Reward: ${objective['reward_money']} and {objective['reward_xp']} XP")
    finally:
        objective_lock = False


def check_drug_unlocks():
    """Check and unlock new drugs based on player level."""
    global unlocked_drugs
    
    for drug_name, config in DRUG_CONFIG.items():
        if drug_name not in unlocked_drugs and level >= config["unlock_level"]:
            unlocked_drugs.append(drug_name)
            slow_print(f"\n*** NEW DRUG UNLOCKED: {drug_name}! ***")
            slow_print(f"Description: {config['description']}")
            slow_print(f"You can now buy {config['seed_name']} from the supplier!")
            add_activity(f"Unlocked: {drug_name}")
            check_objectives()


# ============================================================================
# SAVE SYSTEM
# ============================================================================

def get_save_filename(name):
    """Generate save filename from organization name."""
    # Sanitize filename - remove invalid characters
    safe_name = "".join(c for c in name if c.isalnum() or c in "-_").strip()
    if not safe_name:
        safe_name = "save"
    return f"save_{safe_name}.txt"


def list_saves():
    """List all available save files."""
    saves = []
    if os.path.exists("saves"):
        for filename in os.listdir("saves"):
            if filename.startswith("save_") and filename.endswith(".txt"):
                # Extract org name from filename
                org = filename[5:-4]  # Remove "save_" and ".txt"
                saves.append(org)
    return sorted(saves)


def save_game(save_name=None):
    """Save game state to file with hash verification."""
    global day, money, drugs, seeds, growing_solution
    global risk, reputation, deliveries_done, max_production
    global org_name, unlocked_drugs, workers, stations, recipes
    global level, xp, xp_needed, in_jail, jail_days, total_earned, objective_state, achievements, difficulty

    # Use provided name or global org_name
    if save_name is None:
        save_name = org_name

    if not save_name:
        slow_print("No organization name set!")
        return False

    filename = get_save_filename(save_name)

    # Create saves directory if it doesn't exist
    if not os.path.exists("saves"):
        os.makedirs("saves")

    data = f"{save_name}\n"  # First line is the organization name
    data += f"{day}\n{money}\n"
    # Save drugs as dictionary - store each drug type
    for drug_name in ["Weed", "Cocaine", "Meth"]:
        data += f"{drugs.get(drug_name, 0)}\n"
    # Save seeds per drug type
    for drug_name in ["Weed", "Meth", "Cocaine"]:
        data += f"{seeds.get(drug_name, 0)}\n"
    data += f"{growing_solution}\n"
    data += f"{risk}\n{reputation}\n{deliveries_done}\n"
    data += f"{max_production}\n{workers}\n{total_earned}\n"
    # Save level, xp, xp_needed, in_jail, jail_days
    data += f"{level}\n{xp}\n{xp_needed}\n{in_jail}\n{jail_days}\n"

    # Save stations
    for key in stations:
        data += f"{stations[key]}\n"
    
    # Save recipes
    for key in recipes:
        data += f"{recipes[key]}\n"
    
    # Save upgrades
    for key in upgrades:
        data += f"{upgrades[key]}\n"
    
    # Save unlocked drugs
    data += ",".join(unlocked_drugs) + "\n"
    data += f"{difficulty}\n"
    data += str(len(objective_state)) + "\n"
    for key, objective in objective_state.items():
        data += f"{key}|{objective['progress']}|{objective['done']}\n"

    if not achievements:
        achievements = initialize_achievements()

    data += str(len(achievements)) + "\n"
    for key, achievement in achievements.items():
        data += f"{key}|{achievement['done']}\n"

    hash_value = generate_hash(data)

    filepath = os.path.join("saves", filename)
    with open(filepath, "w") as f:
        f.write(data)
        f.write(hash_value)

    add_activity(f"Saved: {save_name}")
    slow_print(f"Game saved as '{save_name}'.")
    return True


def load_game(save_name):
    """Load game state from file with integrity check."""
    global day, money, drugs, seeds, growing_solution
    global risk, reputation, deliveries_done, max_production
    global upgrades, org_name, unlocked_drugs, workers, stations, recipes
    global level, xp, xp_needed, in_jail, jail_days, total_earned, objective_state, achievements, difficulty, activity_log

    filename = get_save_filename(save_name)
    filepath = os.path.join("saves", filename)

    if not os.path.exists(filepath):
        return False

    with open(filepath, "r") as f:
        lines = f.readlines()

    saved_hash = lines[-1].strip()
    data = "".join(lines[:-1])

    values = data.splitlines()
    if len(values) < 29:
        slow_print("Save file is incomplete!")
        return False

    if generate_hash(data) != saved_hash:
        slow_print("Save file corrupted or tampered with!")
        return False

    # Load values (first line is org name)
    org_name = values[0]
    day = int(values[1])
    money = int(values[2])
    # Load drugs as dictionary - each drug type on separate line
    drugs = {
        "Weed": int(values[3]),
        "Cocaine": int(values[4]),
        "Meth": int(values[5])
    }
    # Load seeds per drug type
    seeds = {
        "Weed": int(values[6]),
        "Meth": int(values[7]),
        "Cocaine": int(values[8])
    }
    growing_solution = int(values[9])
    risk = int(values[10])
    reputation = int(values[11])
    deliveries_done = int(values[12])
    max_production = int(values[13])
    workers = int(values[14])
    total_earned = int(values[15])
    
    # Load level, xp, xp_needed, in_jail, jail_days
    level = int(values[16])
    xp = int(values[17])
    xp_needed = int(values[18])
    in_jail = values[19] == "True"
    jail_days = int(values[20])

    # Load stations
    stations["Grow Room"] = values[21] == "True"
    stations["Lab"] = values[22] == "True"
    
    # Load recipes
    recipes["Weed"] = values[23] == "True"
    recipes["Meth"] = values[24] == "True"
    recipes["Cocaine"] = values[25] == "True"

    upgrades["Safe House"] = values[26] == "True"
    upgrades["Police Bribe"] = values[27] == "True"
    upgrades["Chemist"] = values[28] == "True"
    
    # Load unlocked drugs
    unlocked_drugs = values[29].split(",") if values[29] else ["Weed"]

    if len(values) > 30 and values[30] in DIFFICULTY_SETTINGS:
        difficulty = values[30]
        objective_count = int(values[31]) if len(values) > 31 and values[31].isdigit() else 0
        objective_start = 32
    else:
        difficulty = "normal"
        objective_count = int(values[30]) if len(values) > 30 and values[30].isdigit() else 0
        objective_start = 31

    objective_state = initialize_objectives()

    for i in range(objective_count):
        entry = values[objective_start + i]
        if "|" not in entry:
            continue
        key, progress, done = entry.split("|")
        if key in objective_state:
            objective_state[key]["progress"] = int(progress)
            objective_state[key]["done"] = (done == "True")

    achievements = initialize_achievements()
    achievement_start = objective_start + objective_count
    if len(values) > achievement_start and values[achievement_start].isdigit():
        achievement_count = int(values[achievement_start])
        for i in range(achievement_count):
            entry = values[achievement_start + 1 + i]
            if "|" not in entry:
                continue
            key, done = entry.split("|")
            if key in achievements:
                achievements[key]["done"] = (done == "True")

    check_objectives()
    check_achievements()
    activity_log = []
    add_activity(f"Loaded: {org_name}")
    add_activity("Base restored")
    slow_print(f"Save loaded: {org_name}")
    return True


# ============================================================================
# CORE GAME SYSTEMS
# ============================================================================

def quit_game():
    """Exit the game with save option."""
    choice = input("Are you sure you want to quit? (y/n): ")
    if choice and choice.lower() == "y":
        save_game()
        slow_print("Exiting game...")
        sys.exit()


def check_for_arrest():
    """Check if risk is too high and trigger arrest."""
    global risk, in_jail, jail_days, money, drugs

    if risk >= 100 and not in_jail:
        slow_print("Police raided your base!")
        slow_print("You got arrested!")

        in_jail = True
        jail_days = random.randint(2, 5)

        # Optional punishment
        lost_money = int(money * 0.3)
        money -= lost_money

        lost_drugs = min(sum(drugs.values()), 3)
        # Remove from random drug types
        for _ in range(lost_drugs):
            available = [d for d, c in drugs.items() if c > 0]
            if available:
                drug_to_remove = random.choice(available)
                drugs[drug_to_remove] -= 1

        slow_print(f"You lost ${lost_money} and {lost_drugs} drugs.")
        risk = 0


def generate_customers():
    """Generate random customers for the day."""
    global daily_customers, customers_left_today

    amount = random.randint(3, 5)
    daily_customers = random.sample(POSSIBLE_CUSTOMERS, amount)
    customers_left_today = len(daily_customers)


def get_next_customer():
    """Get the next customer from the queue."""
    global customers_left_today
    if customers_left_today > 0:
        customers_left_today -= 1
        return daily_customers[customers_left_today]
    return None


# ============================================================================
# LEVEL SYSTEM
# ============================================================================

def add_xp(amount):
    """Add XP and check for level up."""
    global xp, level, xp_needed

    xp += amount
    slow_print(f"You gained {amount} XP!")
    check_objectives()

    while xp >= xp_needed:
        xp -= xp_needed
        level += 1
        xp_needed += 50

        slow_print("LEVEL UP!")
        slow_print(f"You are now Level {level}!")

        level_up_bonus()


def level_up_bonus():
    """Apply bonus when leveling up."""
    global reputation

    reputation += 5
    slow_print("Your reputation increased by 5!")
    
    # Check for new drug unlocks
    check_drug_unlocks()


